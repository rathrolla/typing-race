# Socket.io server URL (baked in at build/dev start time)
# Local solo play:
VITE_SOCKET_URL=http://localhost:3002

# LAN play — use your machine's local IP (dev:lan sets this automatically):
# VITE_SOCKET_URL=http://192.168.1.42:3002

# Production — point at your deployed server:
# VITE_SOCKET_URL=https://your-server.example.com
